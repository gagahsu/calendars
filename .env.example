# ---------- Database ----------
# Vercel Postgres / Neon / Supabase pooled connection string.
DATABASE_URL="postgresql://user:password@host:5432/calendars?sslmode=require"

# ---------- Site login (single user) ----------
# The password you type on /login.
APP_PASSWORD="change-me"
# Random 32+ char secret used to sign the session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-hex-string"

# ---------- LINE Messaging API ----------
# From LINE Developers console -> your Messaging API channel.
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
# Your own LINE userId. Reminders are pushed here, and only this id may
# command the bot. Send any message to the bot and check the server logs
# (or the webhook response) to find it.
LINE_USER_ID=""

# ---------- OpenRouter (free models) ----------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Comma separated fallback chain, tried in order. All free tier.
# openrouter/free is OpenRouter's own router across free models; the rest
# are pinned fallbacks in case that router endpoint has an issue, or routes
# to a model that answers with nothing usable.
# Leave this unset to follow the defaults in src/lib/openrouter.ts, which is
# the recommended setting — free slugs get retired and an override pinned in
# an environment variable will not be updated when the code list is.
# Check what is still free with:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[]|select(.pricing.prompt=="0")|.id'
OPENROUTER_MODELS=""

# ---------- Cron ----------
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="change-me"

# ---------- Optional: endpoint overrides ----------
# Point these at a stub or a proxy for local testing. Leave unset in production.
# LINE_API_BASE="https://api.line.me/v2/bot"
# Any OpenAI-compatible gateway works here, not just OpenRouter.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ---------- Optional ----------
# Public URL, used in LINE message links.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
# Monthly spending budget in TWD, used by the AI analysis. 0 = no budget.
MONTHLY_BUDGET="0"
